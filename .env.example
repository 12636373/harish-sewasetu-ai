# ==============================================================================
# Sewa Setu — Production Environment Configuration
# Copy this file to .env before starting the stack: cp .env.example .env
# ==============================================================================

# Public URL where this portal and its MCP endpoints will be reached.
# MUST be set to your public domain or public IP (e.g., https://sewasetu.example.com or http://54.210.12.34:8000).
# This is stamped into OAuth 2.1 RFC 8414 metadata, JWKS, and issued Bearer tokens.
PUBLIC_BASE_URL=http://localhost:8000

# Departmental Officer (Admin) Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-secure-password

# Application Secret Key (Flask Sessions)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_random_secret_key_here

# PostgreSQL Database Credentials
POSTGRES_DB=sewasetu
POSTGRES_USER=sewasetu
POSTGRES_PASSWORD=sewasetu123

# Caddy Automatic HTTPS Configuration (Optional: only needed if using docker-compose.prod.yml)
DOMAIN_NAME=sewasetu.example.com
ACME_EMAIL=admin@example.com
